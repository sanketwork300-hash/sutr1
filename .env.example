# Copy to .env and fill in anything you need. Every value here is optional —
# the defaults in docker-compose.yml are enough to boot locally.

# Signing key for session JWTs. If you leave this unset, the container
# generates a random one on first boot and persists it to the data volume
# (so it's stable across restarts). Set it explicitly if you want to pin it.
# JWT_SECRET_KEY=

# Google login (only if you want to log in with Google in the UI).
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=

# OAuth credentials for specific integrations (one pair per provider).
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# Transactional email via Resend (leave empty + SKIP_EMAIL_VERIFICATION=true
# for local dev, which is the default in docker-compose.yml).
# RESEND_API_KEY=
# EMAIL_FROM=noreply@example.com

# Python log level for the server (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO

# Set to true only when a trusted reverse proxy (bundled Caddy, Fly edge) is
# the sole ingress: uvicorn will then honour X-Forwarded-For so rate limits
# and audit IPs see the real client. docker-compose.prod.yml sets this already.
# TRUST_PROXY_HEADERS=false
# FORWARDED_ALLOW_IPS=*

# Observability. /metrics is disabled by default (returns 404). When enabled,
# set METRICS_TOKEN unless the endpoint is only reachable from your private
# network — Prometheus series carry no tenant identifiers, but request rates
# and latencies are still operational information.
# METRICS_ENABLED=false
# METRICS_TOKEN=

# OpenTelemetry tracing. Needs the optional SDK: uv sync --extra otel
# METRICS/traces are independent — either can run without the other.
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=sutr
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Deployment engine. The local Docker provider builds and runs generated MCP
# servers on this host; it is refused outright on cloud (multi-tenant) instances.
# DEPLOY_DOCKER_ENABLED=true

# Required by docker-compose.prod.yml (install.sh writes these for you).
# DOMAIN=sutr.example.com
# LETSENCRYPT_EMAIL=you@example.com

