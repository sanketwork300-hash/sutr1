# Copy to .env and fill in anything you need. Every value here is optional —
# the defaults in docker-compose.yml are enough to boot locally.

# Signing key for session JWTs. If you leave this unset, the container
# generates a random one on first boot and persists it to the data volume
# (so it's stable across restarts). Set it explicitly if you want to pin it.
# JWT_SECRET_KEY=

# This file is committed to git. Put real values in .env (which is ignored),
# never here.
#
# ─────────────────────────────────────────────────────────────────────────────
# THREE DIFFERENT KINDS OF OAUTH LIVE BELOW. They are not interchangeable, and
# each needs its own redirect URI registered with the provider:
#
#   1. GOOGLE_LOGIN_*   — signing IN to sutr with a Google account
#   2. OAUTH_<PROVIDER>_* — connecting a bundled INTEGRATION (GitHub, Notion, …)
#   3. <PROVIDER>_OAUTH_* — CONNECTED ACCOUNTS: reading specs from GitHub, and
#                           deploying to your own cloud
#
# Note that (2) and (3) differ only in word order. OAUTH_GITHUB_CLIENT_ID is
# the integration credential; GITHUB_OAUTH_CLIENT_ID is the connected account.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Google login (only if you want to log in with Google in the UI).
#    Authorized redirect URI: {BASE_URL}/api/auth/google/callback
#    e.g. http://localhost:4747/api/auth/google/callback
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=

# 2. OAuth credentials for specific integrations (one pair per provider).
#    Redirect URI: whatever OAUTH_CALLBACK_URL is set to
#    ({BASE_URL}/api/auth/callback by default).
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
#    One Google OAuth app serves all twelve Google integrations (Gmail,
#    Calendar, Drive, Docs, Sheets, Slides, Chat, Contacts, Maps Code Assist,
#    Developer Knowledge). See docs → Self-host → Google OAuth Setup.
#    Note this is NOT GOOGLE_LOGIN_* above: that one is only for signing in.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# 3. Connected accounts — the OAuth grants sutr holds on a user's behalf so it
#    can read OpenAPI specs out of GitHub and deploy generated MCP servers to
#    their own cloud. Each is optional; a provider left blank is reported as
#    "not configured" in the UI rather than offering a button that fails.
#    Full walk-through: docs → Self-host → Connected accounts.

#    GitHub, for importing specs (including from private repositories).
#    Authorized callback URL: {BASE_URL}/api/connections/github/callback
#    This is a DIFFERENT callback from the integration app above, so it needs
#    its own OAuth App unless you register a shared parent path.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
#    Scope requested. "repo read:user" is the default and is what private
#    repositories need; narrow it for a public-only install.
# GITHUB_OAUTH_SCOPE=repo read:user

#    Google Cloud, for deploying to Cloud Run. Separate from GOOGLE_LOGIN_*
#    on purpose: cloud-platform is a far larger grant than sign-in.
#    Authorized redirect URI: {BASE_URL}/api/connections/gcp/callback
# GCP_OAUTH_CLIENT_ID=
# GCP_OAUTH_CLIENT_SECRET=

#    Azure, for deploying to Container Apps.
#    Redirect URI (type Web): localhost:4747/api/connections/azure/callback
# AZURE_OAUTH_CLIENT_ID=
# AZURE_OAUTH_CLIENT_SECRET=
# AZURE_OAUTH_TENANT=

#    AWS, for deploying to App Runner. AWS publishes no OAuth for its own
#    service APIs, so this uses IAM Identity Center's device grant — there is
#    no client secret to register, only your access portal URL.
# AWS_SSO_START_URL=https://d-1234567890.awsapps.com/start
# AWS_SSO_REGION=us-east-1

# Transactional email via Resend (leave empty + SKIP_EMAIL_VERIFICATION=true
# for local dev, which is the default in docker-compose.yml).
# RESEND_API_KEY=
# EMAIL_FROM=noreply@example.com

# Python log level for the server (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO

# Log output format.
#   json (default) — one structured object per line carrying correlation,
#                    tenant, agent, provider, tool, runtime, status, duration
#                    and region. This is what a log pipeline (Loki, OpenSearch,
#                    Fluent Bit) should ingest. Credentials are redacted in the
#                    formatter, so a secret cannot reach the stream even if one
#                    is logged by mistake.
#   text           — human-readable, for local development.
# LOG_FORMAT=json

# ── Event bus ─────────────────────────────────────────────────────────────
# Events are ALWAYS written to a transactional outbox, in the same transaction
# as the state change they describe. This chooses only where a relay then
# publishes them.
#   in_process (default) — deliver to handlers in this process. Needs no
#                          infrastructure, so a single-container install works.
#   kafka                — publish to a broker. Also needs
#                          KAFKA_BOOTSTRAP_SERVERS and: uv sync --extra kafka
# EVENT_BUS_BACKEND=in_process
# KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_TOPIC_PREFIX=

# The relay runs inside the API process by default. With more than one API
# replica, set this false and run exactly one `sutr-event-relay` worker
# instead — otherwise replicas contend for the same outbox rows.
# EVENT_RELAY_ENABLED=true

# Emit a usage.recorded event per tool call. Off by default: the usage ledger
# is already durable and authoritative, and nothing consumes the event yet, so
# emitting one would double the write volume of every invocation for no reader.
# EMIT_USAGE_EVENTS=false

# ── Continuous source sync ────────────────────────────────────────────────
# Watching is opt-in per source. This only controls whether the sweep that
# honours those choices runs at all: false means no source is ever polled,
# whatever its own setting says.
# SOURCE_SYNC_ENABLED=true
# How often to look for sources whose own interval is due — not how often any
# one source is polled. Each source has its own interval and its own failure
# backoff.
# SOURCE_SYNC_INTERVAL_SECONDS=300

# MCP transports. Streamable HTTP at /mcp is always on and is the default.
# SSE (GET /sse + POST /messages) is the transport older MCP clients speak;
# set this to false to serve only Streamable HTTP.
# MCP_SSE_ENABLED=true

# Set to true only when a trusted reverse proxy (bundled Caddy, Fly edge) is
# the sole ingress: uvicorn will then honour X-Forwarded-For so rate limits
# and audit IPs see the real client. docker-compose.prod.yml sets this already.
# TRUST_PROXY_HEADERS=false
# FORWARDED_ALLOW_IPS=*

# Tool executions allowed per org per minute (REST and MCP alike). A refusal
# returns 429 with Retry-After and is not metered. 0 disables the limit.
# TOOL_RATE_LIMIT_PER_MINUTE=120

# Observability. /metrics is disabled by default (returns 404). When enabled,
# set METRICS_TOKEN unless the endpoint is only reachable from your private
# network — Prometheus series carry no tenant identifiers, but request rates
# and latencies are still operational information.
# METRICS_ENABLED=false
# METRICS_TOKEN=

# OpenTelemetry tracing. Needs the optional SDK: uv sync --extra otel
# METRICS/traces are independent — either can run without the other.
#
# Traces span Gateway → Discovery → Runtime → Provider, and across processes:
# an inbound `traceparent` is continued rather than replaced, and every
# outbound provider call carries ours. With tracing off, the correlation id
# still propagates — that costs nothing and needs no SDK.
#
# A ready-to-run collector/Prometheus/Loki/Tempo/Grafana stack, single-replica,
# lives in deploy/observability/.
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=sutr
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
#
# Head sampling for traces this process starts. 1.0 keeps everything, which is
# right for a low-volume control plane and wrong for a busy gateway — lower it
# there rather than turning tracing off. A trace the caller already sampled is
# kept regardless, so a cross-service trace does not come back with holes.
# OTEL_TRACES_SAMPLE_RATIO=1.0
#
# mTLS to the collector (LLD §5.3). The CA bundle verifies the collector; the
# client certificate and key authenticate to it. Both halves are needed before
# the platform reports the hop as mutual — half a certificate is not mTLS.
# OTEL_EXPORTER_OTLP_CERTIFICATE=/etc/sutr/certs/ca.crt
# OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE=/etc/sutr/certs/client.crt
# OTEL_EXPORTER_OTLP_CLIENT_KEY=/etc/sutr/certs/client.key
#
# How far back a tenant may look at its own telemetry through
# /v1/observability. A longer window is clamped to this rather than refused.
# TELEMETRY_WINDOW_HOURS_MAX=720

# ── When a provider fails (LLD 5.8) ──────────────────────────────────────────
#
# One number is not a timeout policy: waiting for a handshake to a host that is
# gone is a different failure from reading a slow report. Splitting them is
# what lets a dead host fail in seconds instead of tens of seconds.
# PROVIDER_TIMEOUT_SECONDS=30
# PROVIDER_CONNECT_TIMEOUT_SECONDS=5
# PROVIDER_READ_TIMEOUT_SECONDS=30
# PROVIDER_POOL_TIMEOUT_SECONDS=5
#
# Retries are deliberately few, and only for transport failures on safe
# methods: a response that arrived reached the provider's application, and this
# platform does not know whether the tool it called was idempotent. Backoff is
# exponential with full jitter.
# PROVIDER_RETRY_ATTEMPTS=2
# PROVIDER_RETRY_BASE_SECONDS=0.2
# PROVIDER_RETRY_MAX_SECONDS=5
#
# The circuit breaker. After this many consecutive failures a provider stops
# being called for the cool-off, and one trial call is allowed through when it
# expires. Measured on a dead provider: 10.1s per call before, 9ms after.
# State is per replica — see GET /v1/platform/scaling.
# CIRCUIT_BREAKER_ENABLED=true
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_COOLOFF_SECONDS=30

# ── Running more than one replica (LLD 5.4, 5.7) ─────────────────────────────
#
# "active" serves everything. "standby" serves reads and refuses writes with a
# 503 naming the region that owns them — the mode for a region whose database
# is a read-only replica of another's, where a write would otherwise surface as
# "cannot execute INSERT in a read-only transaction". A standby runs no
# background jobs, because all of them write. Anything unrecognised means
# active: a typo must not take a region out of service.
# PLATFORM_MODE=active
# PRIMARY_REGION=
#
# Connection pooling. Every replica opens its own pool, so PostgreSQL is asked
# for replicas x (pool_size + max_overflow) connections. Exceeding
# max_connections does not slow one replica down — it stops all of them
# connecting at once. Raise these knowing the multiplication.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=1800
#
# A server-side ceiling on any single statement, so a query that will never
# finish cannot hold a pooled connection forever.
#
# DIRECT CONNECTIONS ONLY. This travels as a libpq startup parameter, and
# PgBouncer refuses startup parameters it does not know — every replica behind
# one will fail to boot with "unsupported startup parameter in options:
# statement_timeout". Behind a pooler, set it on the role instead:
#   ALTER ROLE sutr SET statement_timeout = '30s';
# DB_STATEMENT_TIMEOUT_MS=0
#
# Every replica must share the same JWT_SECRET_KEY, or a session issued by one
# is rejected by the next and the symptom is an intermittent logout.
#
# A ready-to-run two-replica stack with PgBouncer and a streaming replica lives
# in deploy/ha/, and a Helm chart in deploy/ha/helm/sutr.

# Deployment engine. The local Docker provider builds and runs generated MCP
# servers on this host; it is refused outright on cloud (multi-tenant) instances.
# The cloud providers additionally need their OAuth app configured above.
# DEPLOY_DOCKER_ENABLED=true
# DEPLOY_GCP_ENABLED=true
# DEPLOY_AZURE_ENABLED=true
# DEPLOY_AWS_ENABLED=true

# Documentation intelligence (LLD 3.5). Uploaded documents are the evidence
# behind every extracted business rule — each rule cites the sentence it came
# from — so the original is kept, not cached.
#
# Where: "database" (default, alongside every other blob this install stores)
# or "filesystem". There is no object-store backend; see ADR-034.
# DOCUMENT_STORAGE_BACKEND=database
# DOCUMENT_STORAGE_PATH=/var/lib/sutr/documents

# Upload ceiling. Parsing cost is superlinear in practice — OCR especially —
# so this is a real limit, not a formality.
# DOCUMENT_MAX_BYTES=26214400

# OCR for PDF pages with no extractable text. Needs Tesseract on PATH; when it
# is absent the pages are flagged and processing continues (LLD 3.5). Slow on
# scanned documents: seconds become minutes.
# DOCUMENT_OCR_ENABLED=true

# Semantic search needs an embedding provider, and none ships. Retrieval falls
# back to BM25 over chunks and every search response says so. No hash-based
# stand-in is used: it would rank results while looking semantic (ADR-033).

# ── MCP generation (LLD 3.6) ────────────────────────────────────────────────
#
# Artifact signing. The LLD asks for signed images via Cosign; this signs the
# artifact's *build hash* with a locally held Ed25519 key instead — a real
# signature over a real digest, but not Sigstore and not an image signature
# (ADR-038). Accepts a PEM private key or a base64-encoded 32-byte seed. Unset,
# artifacts are stored unsigned and every read says so.
# GENERATION_SIGNING_KEY=
# GENERATION_SIGNING_KEY_ID=release-2026

# Security and vulnerability scanning. No scanner and no CVE database ship, so
# these checks report `blocked` — never a pass — unless you name a command.
# Each runs in a directory holding the unpacked generated package; a non-zero
# exit rejects the artifact and its output is stored on the validation report.
# GENERATION_SECURITY_SCAN_COMMAND=semgrep --error --config auto .
# GENERATION_VULNERABILITY_SCAN_COMMAND=trivy fs --exit-code 1 --severity CRITICAL .

# The generated package ships its own offline pytest suite; validation runs it
# where pytest is importable. Turn off only if build time matters more than
# knowing the package works.
# GENERATION_RUN_GENERATED_TESTS=true

# ── Kubernetes runtime (LLD 4.3.8) ──────────────────────────────────────────
#
# NOT TESTED against a live cluster. Every request is built against the
# documented Kubernetes API and asserted in tests against a stub API server.
# KUBERNETES_ENABLED=false
# In-cluster, leave the server and token empty: the pod's own service-account
# token and CA are used.
# KUBERNETES_API_SERVER=https://cluster.example:6443
# KUBERNETES_TOKEN=
# KUBERNETES_CA_CERT_PATH=/etc/ssl/k8s-ca.crt
# KUBERNETES_VERIFY_TLS=true
# The base image the generated package is mounted into as a ConfigMap. It must
# already have the package's dependencies installed (mcp, httpx, uvicorn,
# pyjwt); this provider builds no images. Without it there is nothing to run.
# KUBERNETES_RUNTIME_IMAGE=registry.example/sutr-mcp-base:1
# KUBERNETES_NAMESPACE_PREFIX=sutr
#
# Runtimes are reachable only from namespaces you label
# `sutr.io/ingress=allowed`. Label the gateway's namespace, or nothing outside
# the tenant namespace can reach them — which is the intended default.

# ── Billing and settlement (LLD 5.1) ────────────────────────────────────────
#
# The provider's share of marketplace revenue, in basis points: 8000 is 80%.
# Never hard-coded — it is read on every settlement run, so changing it here
# takes effect without a restart, and a run may override it for a one-off
# arrangement. Whatever applied is written onto the settlement row, so changing
# this does not alter what an old settlement says it paid.
# REVENUE_SHARE_PROVIDER_BPS=8000
#
# Dunning: how long after a failed collection attempt the next one comes due,
# and how many attempts are made before it stops. Attempts are *recorded*, not
# made — nothing here charges a card, and no scheduler calls `due()`.
# DUNNING_RETRY_HOURS=72
# DUNNING_MAX_ATTEMPTS=4
#
# The region this deployment runs in. Recorded on every usage event, put on
# every log line, and attached to traces as the `cloud.region` resource
# attribute. Unset means unknown, and unknown is recorded as null rather than
# as a guess.
# REGION=

# Required by docker-compose.prod.yml (install.sh writes these for you).
# DOMAIN=sutr.example.com
# LETSENCRYPT_EMAIL=you@example.com

