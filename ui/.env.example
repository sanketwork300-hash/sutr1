# Product analytics (PostHog) are off unless a project key is set here. The
# hosted sutr.sh build has its own key; a self-hosted install that wants
# analytics opts in by setting one. Page views are reported by path only —
# never with a query string or fragment.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Set by the Docker build from IS_CLOUD; leave unset for a local checkout.
# VITE_IS_CLOUD=false
